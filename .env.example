# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Local dev only: when NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL points at a local Supabase stack,
# set this to the local anon key (from `supabase status`). Leave unset in production.
NEXT_PUBLIC_SUPABASE_FUNCTIONS_ANON_KEY=

# WhatsApp — international format without +, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Razorpay — get test keys from https://dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# Payment bypass — set "true" for local dev WITHOUT real Razorpay keys; MUST be absent or "false" in production
NEXT_PUBLIC_ENABLE_PAYMENT_BYPASS=false
